# ============================================================================
# LİKYA SUPER-APP — ÜRETİM ORTAMI ŞABLONU (Dokploy / VPS)
# Kullanım:
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ============================================================================

# Supabase platform anahtarları
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# PostgreSQL (self-hosted) — ZORUNLU: güçlü bir şifre seçin
POSTGRES_USER=likya
POSTGRES_PASSWORD=change_me_strong_prod_secret
POSTGRES_DB=likya

# Local Whisper ASR (koç sesli notları — Otter.ai/Fireflies yerine sıfır maliyet)
WHISPER_TAG=latest-cpu        # NVIDIA GPU'lu VPS için: latest-gpu
WHISPER_ENGINE=openai_whisper # faster_whisper da kullanılabilir
WHISPER_MODEL=small           # küçük = hızlı; large-v3 = en doğru
WHISPER_LANGUAGE=tr
WHISPER_GPU=false             # NVIDIA GPU varsa true

# Sporcu medya kasası yerel disk kökü (konteyner içinde otomatik bağlanır)
LIKYA_MEDIA_ROOT=/var/lib/likya/media

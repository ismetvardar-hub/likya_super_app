# Next.js Admin Dashboard Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_ADMIN_TITLE="Likya CEO Command Center"

# ============================================================================
# 🤖 A-B-C-D HİBRİT MODEL ŞELALESİ — Opsiyonel API Anahtarları
# Aşağıdaki anahtarlardan hangisini eklerseniz o plan otomatik devreye girer.
# Hiçbiri zorunlu değildir; eklenmeyen planlar şelalede sessizce atlanır.
# ============================================================================
# ✅ ZORUNLU (kod üretimi için): DeepSeek
NEXT_PUBLIC_DEEPSEEK_API_KEY=your-deepseek-api-key-here
# ✅ ZORUNLU (sohbet/araştırma için): Google Gemini
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here
# ✅ Yerel yedek: Ollama (Plan F — internet gerektirmez)
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
NEXT_PUBLIC_OLLAMA_MODEL=qwen2.5-coder:7b

# ⏭️ HAZIR-BEKLER Planlar (anahtar ekleyince otomatik aktifleşir):
# OpenAI GPT (Plan C) — hem kod hem sohbet
# OPENAI_API_KEY=sk-...
# Anthropic Claude (Plan D) — hem kod hem sohbet
# ANTHROPIC_API_KEY=sk-ant-...
# Groq (Plan B) — kod: qwen-2.5-coder-32b / sohbet: llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...
# Mistral Codestral (kod Plan E)
# MISTRAL_API_KEY=...
# OpenRouter Free (sohbet Plan E)
# OPENROUTER_API_KEY=sk-or-...

# 📲 VIP BİLDİRİM HATTI (opsiyonel) — kritik olayları Patron'a anlık iletir
# Telegram Bot (https://t.me/BotFather üzerinden alın)
# TELEGRAM_BOT_TOKEN=123456:ABC-...
# TELEGRAM_CHAT_ID=123456789
# Discord sunucu webhook URL'i
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 🌤️ Hava Durumu DJ Otomasyonu (Open-Meteo) — ücretsiz, anahtar GEREKMEZ

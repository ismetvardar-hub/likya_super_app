# ============================================================================
# 🛡️ SPORTVISIONX — ÜRETİM ORTAM ŞABLONU (Dokploy / Traefik stack)
# Kullanım:
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Doğrulama: uygulama açılışında envValidator (fail-fast) bu anahtarları kontrol eder —
#            eksik/hatalı sırla uygulama BAŞLATILMAZ. Test: node scripts/productionDeploymentSmokeTest.mts
# ============================================================================

# ── ZORUNLU (envValidator.REQUIRED_ENV_RULES) ────────────────────────────────
# Supabase proje URL (https://<ref>.supabase.co biçiminde OLMALI)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service role anahtarı (≥20 karakter — sunucu tarafı, client bundle'a asla girmemeli)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenRouter AI gateway anahtarı (≥16 karakter, sk-or-...)
OPENROUTER_API_KEY=sk-or-your-key-here

# GVS KNX aydınlatma gateway host (IP[:port] biçiminde)
KNX_GATEWAY_HOST=10.0.0.1:3671

# JWT imzalama sırrı (≥16 karakter — rastgele üretin: openssl rand -hex 32)
JWT_SECRET=change-me-strong-jwt-secret-32chars+

# ── TRAEFIK ───────────────────────────────────────────────────────────────────
# SportVisionX domain (Let's Encrypt sertifikası bu Host üzerinden tetiklenir)
DOMAIN=app.sportvisionx.com

# ── REDIS (compose içinde otomatik) ──────────────────────────────────────────
REDIS_URL=redis://redis-cache:6379

# ── İSTEĞE BAĞLI (envValidator zorunlu değil) ────────────────────────────────
# Calendr takvim aboneliği token doğrulama sırrı
CALENDAR_FEED_SECRET=change-me-calendar-secret

# Push bildirimleri (APNS/FCM) — sonraki aşama
# APNS_KEY_ID=
# FCM_SERVER_KEY=

# ⚠️ GERÇEK SIRLARINIZI ASLA GİT'E İTMEYİN: .env.prod dosyası .gitignore'da olmalıdır.

# Likya Super-App Backend — ortam değişkenleri şablonu
# Kopyala: cp .env.example .env

# Uygulama
NODE_ENV=development
PORT=4000

# PostgreSQL + PostGIS (docker-compose yerel; prod'da Supabase pooler URL'si)
DATABASE_URL=postgres://likya:likya_dev_secret@localhost:5432/likya

# Redis (docker-compose yerel)
REDIS_URL=redis://localhost:6379

# JWT (üretimde uzun ve rastgele — asla repo'ya işleme)
JWT_SECRET=change_me_jwt_secret_32chars_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Supabase Service Key (admin paneli ile ortak auth.users için isteğe bağlı)
SUPABASE_SERVICE_ROLE_KEY=
